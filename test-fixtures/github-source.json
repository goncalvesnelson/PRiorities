["/*---------------------------------------------------------------------------------------------", " *  Copyright (c) Microsoft Corporation. All rights reserved.", " *  Licensed under the MIT License. See License.txt in the project root for license information.", " *--------------------------------------------------------------------------------------------*/", "", "import { $, append, hide, show } from '../../../../base/browser/dom.js';", "import { IconLabel, IIconLabelValueOptions } from '../../../../base/browser/ui/iconLabel/iconLabel.js';", "import { IListRenderer } from '../../../../base/browser/ui/list/list.js';", "import { Codicon } from '../../../../base/common/codicons.js';", "import { ThemeIcon } from '../../../../base/common/themables.js';", "import { Emitter, Event } from '../../../../base/common/event.js';", "import { createMatches } from '../../../../base/common/filters.js';", "import { DisposableStore } from '../../../../base/common/lifecycle.js';", "import { URI } from '../../../../base/common/uri.js';", "import { ICodeEditor } from '../../../browser/editorBrowser.js';", "import { EditorOption } from '../../../common/config/editorOptions.js';", "import { CompletionItemKind, CompletionItemKinds, CompletionItemTag } from '../../../common/languages.js';", "import { getIconClasses } from '../../../common/services/getIconClasses.js';", "import { IModelService } from '../../../common/services/model.js';", "import { ILanguageService } from '../../../common/languages/language.js';", "import * as nls from '../../../../nls.js';", "import { FileKind } from '../../../../platform/files/common/files.js';", "import { registerIcon } from '../../../../platform/theme/common/iconRegistry.js';", "import { IThemeService } from '../../../../platform/theme/common/themeService.js';", "import { CompletionItem } from './suggest.js';", "import { canExpandCompletionItem } from './suggestWidgetDetails.js';", "", "const suggestMoreInfoIcon = registerIcon('suggest-more-info', Codicon.chevronRight, nls.localize('suggestMoreInfoIcon', 'Icon for more information in the suggest widget.'));", "", "const _completionItemColor = new class ColorExtractor {", "", "\tprivate static _regexRelaxed = /(#([\\da-fA-F]{3}){1,2}|(rgb|hsl)a\\(\\s*(\\d{1,3}%?\\s*,\\s*){3}(1|0?\\.\\d+)\\)|(rgb|hsl)\\(\\s*\\d{1,3}%?(\\s*,\\s*\\d{1,3}%?){2}\\s*\\))/;", "\tprivate static _regexStrict = new RegExp(`^${ColorExtractor._regexRelaxed.source}$`, 'i');", "", "\textract(item: CompletionItem, out: string[]): boolean {", "\t\tif (item.textLabel.match(ColorExtractor._regexStrict)) {", "\t\t\tout[0] = item.textLabel;", "\t\t\treturn true;", "\t\t}", "\t\tif (item.completion.detail && item.completion.detail.match(ColorExtractor._regexStrict)) {", "\t\t\tout[0] = item.completion.detail;", "\t\t\treturn true;", "\t\t}", "", "\t\tif (item.completion.documentation) {", "\t\t\tconst value = typeof item.completion.documentation === 'string'", "\t\t\t\t? item.completion.documentation", "\t\t\t\t: item.completion.documentation.value;", "", "\t\t\tconst match = ColorExtractor._regexRelaxed.exec(value);", "\t\t\tif (match && (match.index === 0 || match.index + match[0].length === value.length)) {", "\t\t\t\tout[0] = match[0];", "\t\t\t\treturn true;", "\t\t\t}", "\t\t}", "\t\treturn false;", "\t}", "};", "", "", "export interface ISuggestionTemplateData {", "\treadonly root: HTMLElement;", "", "\t/**", "\t * Flexbox", "\t * < ------------- left ------------ >     < --- right -- >", "\t * <icon><label><signature><qualifier>     <type><readmore>", "\t */", "\treadonly left: HTMLElement;", "\treadonly right: HTMLElement;", "", "\treadonly icon: HTMLElement;", "\treadonly colorspan: HTMLElement;", "\treadonly iconLabel: IconLabel;", "\treadonly iconContainer: HTMLElement;", "\treadonly parametersLabel: HTMLElement;", "\treadonly qualifierLabel: HTMLElement;", "\t/**", "\t * Showing either `CompletionItem#details` or `CompletionItemLabel#type`", "\t */", "\treadonly detailsLabel: HTMLElement;", "\treadonly readMore: HTMLElement;", "\treadonly disposables: DisposableStore;", "", "\treadonly configureFont: () => void;", "}", "", "export class ItemRenderer implements IListRenderer<CompletionItem, ISuggestionTemplateData> {", "", "\tprivate readonly _onDidToggleDetails = new Emitter<void>();", "\treadonly onDidToggleDetails: Event<void> = this._onDidToggleDetails.event;", "", "\treadonly templateId = 'suggestion';", "", "\tconstructor(", "\t\tprivate readonly _editor: ICodeEditor,", "\t\t@IModelService private readonly _modelService: IModelService,", "\t\t@ILanguageService private readonly _languageService: ILanguageService,", "\t\t@IThemeService private readonly _themeService: IThemeService", "\t) { }", "", "\tdispose(): void {", "\t\tthis._onDidToggleDetails.dispose();", "\t}", "", "\trenderTemplate(container: HTMLElement): ISuggestionTemplateData {", "\t\tconst disposables = new DisposableStore();", "", "\t\tconst root = container;", "\t\troot.classList.add('show-file-icons');", "", "\t\tconst icon = append(container, $('.icon'));", "\t\tconst colorspan = append(icon, $('span.colorspan'));", "", "\t\tconst text = append(container, $('.contents'));", "\t\tconst main = append(text, $('.main'));", "", "\t\tconst iconContainer = append(main, $('.icon-label.codicon'));", "\t\tconst left = append(main, $('span.left'));", "\t\tconst right = append(main, $('span.right'));", "", "\t\tconst iconLabel = new IconLabel(left, { supportHighlights: true, supportIcons: true });", "\t\tdisposables.add(iconLabel);", "", "\t\tconst parametersLabel = append(left, $('span.signature-label'));", "\t\tconst qualifierLabel = append(left, $('span.qualifier-label'));", "\t\tconst detailsLabel = append(right, $('span.details-label'));", "", "\t\tconst readMore = append(right, $('span.readMore' + ThemeIcon.asCSSSelector(suggestMoreInfoIcon)));", "\t\treadMore.title = nls.localize('readMore', \"Read More\");", "", "\t\tconst configureFont = () => {", "\t\t\tconst options = this._editor.getOptions();", "\t\t\tconst fontInfo = options.get(EditorOption.fontInfo);", "\t\t\tconst fontFamily = fontInfo.getMassagedFontFamily();", "\t\t\tconst fontFeatureSettings = fontInfo.fontFeatureSettings;", "\t\t\tconst fontVariationSettings = fontInfo.fontVariationSettings;", "\t\t\tconst fontSize = options.get(EditorOption.suggestFontSize) || fontInfo.fontSize;", "\t\t\tconst lineHeight = options.get(EditorOption.suggestLineHeight) || fontInfo.lineHeight;", "\t\t\tconst fontWeight = fontInfo.fontWeight;", "\t\t\tconst letterSpacing = fontInfo.letterSpacing;", "\t\t\tconst fontSizePx = `${fontSize}px`;", "\t\t\tconst lineHeightPx = `${lineHeight}px`;", "\t\t\tconst letterSpacingPx = `${letterSpacing}px`;", "", "\t\t\troot.style.fontSize = fontSizePx;", "\t\t\troot.style.fontWeight = fontWeight;", "\t\t\troot.style.letterSpacing = letterSpacingPx;", "\t\t\tmain.style.fontFamily = fontFamily;", "\t\t\tmain.style.fontFeatureSettings = fontFeatureSettings;", "\t\t\tmain.style.fontVariationSettings = fontVariationSettings;", "\t\t\tmain.style.lineHeight = lineHeightPx;", "\t\t\ticon.style.height = lineHeightPx;", "\t\t\ticon.style.width = lineHeightPx;", "\t\t\treadMore.style.height = lineHeightPx;", "\t\t\treadMore.style.width = lineHeightPx;", "\t\t};", "", "\t\treturn { root, left, right, icon, colorspan, iconLabel, iconContainer, parametersLabel, qualifierLabel, detailsLabel, readMore, disposables, configureFont };", "\t}", "", "\trenderElement(element: CompletionItem, index: number, data: ISuggestionTemplateData): void {", "", "", "\t\tdata.configureFont();", "", "\t\tconst { completion } = element;", "\t\tdata.colorspan.style.backgroundColor = '';", "", "\t\tconst labelOptions: IIconLabelValueOptions = {", "\t\t\tlabelEscapeNewLines: true,", "\t\t\tmatches: createMatches(element.score)", "\t\t};", "", "\t\tconst color: string[] = [];", "\t\tif (completion.kind === CompletionItemKind.Color && _completionItemColor.extract(element, color)) {", "\t\t\t// special logic for 'color' completion items", "\t\t\tdata.icon.className = 'icon customcolor';", "\t\t\tdata.iconContainer.className = 'icon hide';", "\t\t\tdata.colorspan.style.backgroundColor = color[0];", "", "\t\t} else if (completion.kind === CompletionItemKind.File && this._themeService.getFileIconTheme().hasFileIcons) {", "\t\t\t// special logic for 'file' completion items", "\t\t\tdata.icon.className = 'icon hide';", "\t\t\tdata.iconContainer.className = 'icon hide';", "\t\t\tconst labelClasses = getIconClasses(this._modelService, this._languageService, URI.from({ scheme: 'fake', path: element.textLabel }), FileKind.FILE);", "\t\t\tconst detailClasses = getIconClasses(this._modelService, this._languageService, URI.from({ scheme: 'fake', path: completion.detail }), FileKind.FILE);", "\t\t\tlabelOptions.extraClasses = labelClasses.length > detailClasses.length ? labelClasses : detailClasses;", "", "\t\t} else if (completion.kind === CompletionItemKind.Folder && this._themeService.getFileIconTheme().hasFolderIcons) {", "\t\t\t// special logic for 'folder' completion items", "\t\t\tdata.icon.className = 'icon hide';", "\t\t\tdata.iconContainer.className = 'icon hide';", "\t\t\tlabelOptions.extraClasses = [", "\t\t\t\tgetIconClasses(this._modelService, this._languageService, URI.from({ scheme: 'fake', path: element.textLabel }), FileKind.FOLDER),", "\t\t\t\tgetIconClasses(this._modelService, this._languageService, URI.from({ scheme: 'fake', path: completion.detail }), FileKind.FOLDER)", "\t\t\t].flat();", "\t\t} else {", "\t\t\t// normal icon", "\t\t\tdata.icon.className = 'icon hide';", "\t\t\tdata.iconContainer.className = '';", "\t\t\tdata.iconContainer.classList.add('suggest-icon', ...ThemeIcon.asClassNameArray(CompletionItemKinds.toIcon(completion.kind)));", "\t\t}", "", "\t\tif (completion.tags && completion.tags.indexOf(CompletionItemTag.Deprecated) >= 0) {", "\t\t\tlabelOptions.extraClasses = (labelOptions.extraClasses || []).concat(['deprecated']);", "\t\t\tlabelOptions.matches = [];", "\t\t}", "", "\t\tdata.iconLabel.setLabel(element.textLabel, undefined, labelOptions);", "\t\tif (typeof completion.label === 'string') {", "\t\t\tdata.parametersLabel.textContent = '';", "\t\t\tdata.detailsLabel.textContent = stripNewLines(completion.detail || '');", "\t\t\tdata.root.classList.add('string-label');", "\t\t} else {", "\t\t\tdata.parametersLabel.textContent = stripNewLines(completion.label.detail || '');", "\t\t\tdata.detailsLabel.textContent = stripNewLines(completion.label.description || '');", "\t\t\tdata.root.classList.remove('string-label');", "\t\t}", "", "\t\tif (this._editor.getOption(EditorOption.suggest).showInlineDetails) {", "\t\t\tshow(data.detailsLabel);", "\t\t} else {", "\t\t\thide(data.detailsLabel);", "\t\t}", "", "\t\tif (canExpandCompletionItem(element)) {", "\t\t\tdata.right.classList.add('can-expand-details');", "\t\t\tshow(data.readMore);", "\t\t\tdata.readMore.onmousedown = e => {", "\t\t\t\te.stopPropagation();", "\t\t\t\te.preventDefault();", "\t\t\t};", "\t\t\tdata.readMore.onclick = e => {", "\t\t\t\te.stopPropagation();", "\t\t\t\te.preventDefault();", "\t\t\t\tthis._onDidToggleDetails.fire();", "\t\t\t};", "\t\t} else {", "\t\t\tdata.right.classList.remove('can-expand-details');", "\t\t\thide(data.readMore);", "\t\t\tdata.readMore.onmousedown = null;", "\t\t\tdata.readMore.onclick = null;", "\t\t}", "\t}", "", "\tdisposeTemplate(templateData: ISuggestionTemplateData): void {", "\t\ttemplateData.disposables.dispose();", "\t}", "}", "", "function stripNewLines(str: string): string {", "\treturn str.replace(/\\r\\n|\\r|\\n/g, '');", "}"]
