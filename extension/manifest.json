{
  "manifest_version": 3,
  "minimum_chrome_version": "133",
  "name": "PRiorities",
  "version": "0.5.5",
  "description": "Focus GitHub pull requests on the changes that need your judgment.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.bundle.js",
    "type": "module"
  },
  "action": {
    "default_title": "PRiorities settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": ["review.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "review-ui.js",
        "github.js",
        "review-data.js",
        "review-preferences.js",
        "diff.js",
        "review.css"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ]
}
